# Supabase → Project Settings → API (ou "Connect" no topo do painel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
# Só no servidor: NÃO usar o prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: modelo a usar (padrão: gemini-flash-latest)
GEMINI_MODEL=
