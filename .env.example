# Supabase → Project Settings → API (ou "Connect" no topo do painel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key (https://aistudio.google.com/apikey)
# Só no servidor: NÃO usar o prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional: modelo a usar (padrão: gemini-flash-lite-latest)
GEMINI_MODEL=

# Opcional: lembretes por notificação push (ver README → Lembretes por notificação)
# Chaves geradas com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Segredo do cron da Vercel; o SHA-256 dele fica na base de dados.
CRON_SECRET=
